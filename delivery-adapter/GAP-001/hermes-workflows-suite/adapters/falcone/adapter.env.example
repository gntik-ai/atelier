# Non-secret Falcone delivery configuration.
FALCONE_SOURCE_REPO_DIR=/home/hermes/projects/falcone
FALCONE_CHART_REPO_DIR=/home/hermes/projects/falcone-charts
FALCONE_GITHUB_REPO=gntik-ai/falcone
FALCONE_CHART_GITHUB_REPO=gntik-ai/falcone-charts
FALCONE_RELEASE_WORKFLOW=release-images.yml
FALCONE_CLUSTER_CONTEXT=default
FALCONE_NAMESPACE=in-falcone-staging
FALCONE_HELM_RELEASE=REPLACE_WITH_FALCONE_HELM_RELEASE
FALCONE_CHART_RELATIVE_PATH=charts/in-falcone
FALCONE_STAGING_VALUES_RELATIVE_PATH=charts/in-falcone/values/staging.yaml
# Optional colon-separated additional values files; absolute paths or paths relative to the selected chart worktree.
FALCONE_EXTRA_VALUES_FILES=
FALCONE_HELM_TIMEOUT=30m

# Internal chart arguments derived only from producer-backed evidence. Keep them
# false in adapter.env; setting them manually never authorizes an upgrade.
FALCONE_BACKUP_VERIFIED=false
FALCONE_PARITY_VERIFIED=false
FALCONE_BACKUP_REFERENCE=
FALCONE_CURRENT_VERSION=REPLACE_WITH_LIVE_CURRENT_VERSION
# Preferred producer-backed input. Create with:
#   hdeploy falcone backup-evidence /secure/evidence/falcone-staging.json
# The adapter validates target, coverage, restore isolation, parity and expiry,
# then derives the three legacy values above rather than trusting declarations.
FALCONE_BACKUP_EVIDENCE_FILE=
FALCONE_BACKUP_CUSTODY_DIR=/home/hermes/.hermes/backup-custody/falcone
FALCONE_RESTORE_POSTGRES_IMAGE=docker.io/library/postgres:17.2-alpine@sha256:7e5df973a74872482e320dcbdeb055e178d6f42de0558b083892c50cda833c96
# Optional, explicit Option-B evidence document. When set, it must be bound to
# the exact revision set/chart commit and may only cover approved non-database
# paths. It does not change either verified boolean to true.
FALCONE_MIGRATION_WAIVER_FILE=

# Optional stable version override (e.g. v0.6.3). When empty, hdeploy patch-bumps
# the latest stable GitHub release.
FALCONE_RELEASE_VERSION=

# Mandatory authenticated acceptance command. It must read URL/credentials from
# /home/hermes/.hermes/audit.env and must not print secrets.
FALCONE_RUNTIME_VERIFY_COMMAND="/home/hermes/bin/hruntime-verify falcone"

# Optional GHCR credentials. Public packages can leave these empty. If private,
# use a token with read:packages; keep the real values in a chmod-600 env file.
GHCR_USERNAME=
GHCR_TOKEN=
