{
  "openapi": "3.1.0",
  "info": {
    "title": "Falcone Workspace API",
    "version": "__VERSION__",
    "description": "Workspace-scoped API contract generated from enabled capabilities."
  },
  "servers": [
    {
      "url": "__BASE_URL__",
      "description": "Workspace API"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "code", "message", "detail", "requestId", "correlationId", "timestamp", "resource"],
        "properties": {
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "code": { "type": "string", "pattern": "^GW_[A-Z0-9_]+$" },
          "message": { "type": "string" },
          "detail": { "$ref": "#/components/schemas/ErrorDetail" },
          "requestId": { "type": "string", "minLength": 8, "maxLength": 128 },
          "correlationId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
          "timestamp": { "type": "string", "format": "date-time" },
          "resource": { "$ref": "#/components/schemas/ErrorResource" },
          "retryable": { "type": "boolean" }
        }
      },
      "ErrorDetail": { "type": "object", "additionalProperties": true, "properties": { "reason": { "type": "string" }, "violations": { "type": "array", "items": { "type": "string" } } } },
      "ErrorResource": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "type": { "type": "string" }, "id": { "type": "string" }, "path": { "type": "string" } } },
      "PaginationMeta": {
        "type": "object",
        "required": ["page", "pageSize", "total"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "minimum": 1 },
          "total": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "security": [
    { "BearerAuth": [] },
    { "ApiKeyAuth": [] }
  ],
  "paths": {},
  "tags": []
}
