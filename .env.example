# Realtime subscriptions
REALTIME_SUBSCRIPTION_DEFAULT_QUOTA=100
REALTIME_TENANT_DEFAULT_QUOTA=500
REALTIME_SUBSCRIPTION_KAFKA_TOPIC=console.realtime.subscription-lifecycle
REALTIME_SUBSCRIPTION_KAFKA_RETENTION_MS=2592000000
REALTIME_CHANNELS_CACHE_TTL_SECONDS=60
# Knative runtime integration (managed support remains proposed until coordinated chart acceptance).
# The control plane only observes the chart-owned status file; it never mutates an external or
# managed Knative installation through these settings. Missing/malformed status fails closed.
KNATIVE_RUNTIME_MODE=disabled
KNATIVE_RUNTIME_STATUS_FILE=/var/run/falcone/knative/status.json
FUNCTIONS_ENABLED=true
MCP_RUNTIME_API_BASE_URL=http://falcone-control-plane-executor.falcone.svc.cluster.local:8080
